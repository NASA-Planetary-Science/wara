  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background-color: #0a0a0f;
    color: #e8eaf6;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
}
QLabel {
    color: #e8eaf6;
    background: transparent;
}
QLabel#title {
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 4px;
    color: #00e5ff;
}
QLabel#subtitle {
    font-size: 10px;
    color: #5c6bc0;
    letter-spacing: 2px;
}
QLabel#value_label {
    font-size: 13px;
    color: #39ff14;
    font-weight: bold;
}
QLabel#section_header {
    font-size: 10px;
    color: #5c6bc0;
    letter-spacing: 3px;
    font-weight: bold;
    padding: 4px 0px 2px 0px;
}
QPushButton {
    background-color: #13131f;
    color: #e8eaf6;
    border: 1px solid #1e1e3a;
    border-radius: 4px;
    padding: 7px 14px;
    font-family: 'Consolas', monospace;
    font-size: 11px;
    letter-spacing: 1px;
}
QPushButton:hover {
    background-color: #1c1c2e;
    border: 1px solid #00e5ff;
    color: #00e5ff;
}
QPushButton:pressed {
    background-color: #0d1b2a;
    border: 1px solid #00e5ff;
}
QPushButton#primary_btn {
    background-color: #0d1f2d;
    border: 1px solid #00e5ff;
    color: #00e5ff;
    font-weight: bold;
}
QPushButton#primary_btn:hover {
    background-color: #112a3d;
    border: 1px solid #80f0ff;
    color: #80f0ff;
}
QPushButton#danger_btn {
    border: 1px solid #ff3b5c;
    color: #ff3b5c;
}
QPushButton#danger_btn:hover {
    background-color: #1a0a10;
    border: 1px solid #ff6b84;
    color: #ff6b84;
}
QFrame#separator {
    background-color: #1e1e3a;
    min-height: 1px;
    max-height: 1px;
}
QFrame#panel {
    background-color: #0f0f1a;
    border: 1px solid #1e1e3a;
    border-radius: 6px;
}
QGroupBox {
    border: 1px solid #1e1e3a;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 8px;
    font-size: 10px;
    color: #5c6bc0;
    letter-spacing: 2px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    top: -1px;
    color: #5c6bc0;
}
QCheckBox {
    color: #e8eaf6;
    spacing: 8px;
    font-size: 11px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #1e1e3a;
    border-radius: 3px;
    background: #13131f;
}
QCheckBox::indicator:checked {
    background: #00e5ff;
    border-color: #00e5ff;
}
QSlider::groove:horizontal {
    height: 3px;
    background: #1e1e3a;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #00e5ff;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}
QSlider::sub-page:horizontal {
    background: #00e5ff;
    border-radius: 2px;
}
QComboBox {
    background: #13131f;
    border: 1px solid #1e1e3a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e8eaf6;
    font-family: 'Consolas', monospace;
    font-size: 11px;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background: #0f0f1a;
    border: 1px solid #1e1e3a;
    color: #e8eaf6;
    selection-background-color: #1c1c2e;
    selection-color: #00e5ff;
}
QSpinBox, QDoubleSpinBox {
    background: #13131f;
    border: 1px solid #1e1e3a;
    border-radius: 4px;
    padding: 3px 6px;
    color: #e8eaf6;
    font-family: 'Consolas', monospace;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #13131f;
    border: none;
    width: 16px;
}
QStatusBar {
    background: #0f0f1a;
    color: #5c6bc0;
    border-top: 1px solid #1e1e3a;
    font-size: 10px;
    letter-spacing: 1px;
}
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical {
    background: #0a0a0f;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #1e1e3a;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolBar {
    background: #0f0f1a;
    border-bottom: 1px solid #1e1e3a;
    spacing: 4px;
    padding: 3px;
}
QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    color: #5c6bc0;
    padding: 3px 6px;
    font-size: 11px;
}
QToolBar QToolButton:hover {
    border-color: #1e1e3a;
    color: #e8eaf6;
    background: #1c1c2e;
}</string>
